# ── Haus of DADA — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. It is already in .gitignore.

# ── Groq AI (Primary LLM) ───────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# ── OpenRouter AI (Fallback LLM — optional) ──────────────────────────────────
# Get your key at: https://openrouter.ai/keys
# Used as automatic fallback when Groq hits rate limits.
OPENROUTER_API_KEY=

# ── Gemini AI ──
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Google Sheets (Lead Storage) ─────────────────────────────────────────────
# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit
GOOGLE_SHEET_ID=

# Full JSON string of your Google Service Account credentials.
# See GOOGLE-SHEETS-SETUP.md for detailed instructions.
# Wrap the entire JSON in single quotes when setting in terminal.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Gmail SMTP (Email Notifications) ─────────────────────────────────────────
# Use a Google App Password (NOT your Gmail login password).
# Enable at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_PASS=
