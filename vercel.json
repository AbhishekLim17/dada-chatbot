{
  "version": 2,
  "headers": [
    {
      "source": "/chatbot/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 30 },
    "api/lead.js": { "maxDuration": 15 },
    "api/analytics.js": { "maxDuration": 15 }
  }
}
